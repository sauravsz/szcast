{
  "version": "0.2.0",
  "configurations": [
    {
      // F5: build the .app, then debug the binary *inside* the bundle so NSBundle.main
      // resolves Info.plist (LSUIElement) and resources. Path matches the fixed
      // -derivedDataPath used by the build task.
      "type": "swift",
      "request": "launch",
      "name": "Run szcast Dev (bundled .app)",
      "program": "${workspaceFolder}/build/DerivedData/Build/Products/Debug/szcast Dev.app/Contents/MacOS/szcast Dev",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build szcast.app (debug)"
    }
  ]
}
