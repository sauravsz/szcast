    "Changes can't be saved: the database couldn't be opened. Its file is untouched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen können nicht gesichert werden: Die Datenbank konnte nicht geöffnet werden. Ihre Datei bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pueden guardar los cambios: no se pudo abrir la base de datos. Su archivo no se ha modificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications ne peuvent pas être enregistrées : la base de données n’a pas pu être ouverte. Son fichier n’a pas été modifié."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更を保存できません。データベースを開けませんでした。ファイルは変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경 사항을 저장할 수 없습니다. 데이터베이스를 열 수 없습니다. 파일은 그대로 유지됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível salvar as alterações: o banco de dados não pôde ser aberto. O arquivo dele não foi modificado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменения не могут быть сохранены: не удалось открыть базу данных. Её файл не затронут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法存储更改：无法打开数据库。其文件未被改动。"
          }
        }
      }
    },
