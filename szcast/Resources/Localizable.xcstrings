          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe principal est requis pour déverrouiller la base de données."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
