        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 키로 사용할 수 있는 모델을 검색하여 하나 이상 추가하십시오. 검색이 지원되지 않는 경우에도 정확한 모델 ID를 사용할 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
