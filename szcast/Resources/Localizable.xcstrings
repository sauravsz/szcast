    "Search the models available to this key and add one or more. Exact model IDs remain available when discovery is unsupported." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsuche die für diesen Schlüssel verfügbaren Modelle und füge eines oder mehrere hinzu. Exakte Modell-IDs bleiben verfügbar, wenn die Erkennung nicht unterstützt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
