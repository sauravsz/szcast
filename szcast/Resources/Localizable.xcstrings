    "Highlight text in any app and speak an instruction to rewrite, translate, or summarize in place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere Text in einer beliebigen App und sprich eine Anweisung zum Umschreiben, Übersetzen oder Zusammenfassen direkt an Ort und Stelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona texto en cualquier app y dicta una instrucción para reescribirlo, traducirlo o resumirlo al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez du texte dans n’importe quelle app et dictez une instruction pour le réécrire, le traduire ou le résumer sur place."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意のアプリでテキストを選択して指示を話すだけで、その場で書き換え・翻訳・要約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원하는 앱에서 텍스트를 선택한 뒤 지시를 말하면 그 자리에서 바로 다듬고, 번역하고, 요약합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
