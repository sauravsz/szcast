        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалено %1$lld трекинг-параметр%2$@ и скопировано"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已移除 %1$lld 个跟踪参数%2$@并复制"
          }
        }
      }
    },
    "Removes build files left by an interrupted install, and the storage of extensions that are no longer installed. Installed extensions are untouched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt Build-Dateien einer unterbrochenen Installation und den Speicher von Erweiterungen, die nicht mehr installiert sind. Installierte Erweiterungen bleiben unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina los archivos de compilación que dejó una instalación interrumpida y los datos de extensiones que ya no están instaladas. Las extensiones instaladas no se modifican."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les fichiers de compilation laissés par une installation interrompue, ainsi que le stockage des extensions qui ne sont plus installées. Les extensions installées ne sont pas touchées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中断されたインストールで残ったビルドファイルと、インストールされなくなった拡張機能のストレージを削除します。インストール済みの拡張機能には影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중단된 설치에서 남은 빌드 파일과 더 이상 설치되지 않은 확장 프로그램의 저장 공간을 제거합니다. 설치된 확장 프로그램은 영향을 받지 않습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove arquivos de compilação deixados por uma instalação interrompida e o armazenamento de extensões que não estão mais instaladas. As extensões instaladas não são afetadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет файлы сборки, оставшиеся после прерванной установки, и хранилище расширений, которые больше не установлены. Установленные расширения не затрагиваются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除因安装中断而遗留的构建文件，以及已不再安装的扩展所占用的存储空间。已安装的扩展不受影响。"
          }
        }
      }
    },
    "Removes every item in the history." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt alle Objekte im Verlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todos los elementos del historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime tous les éléments de l’historique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴内のすべての項目を削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록의 모든 항목을 제거합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove todos os itens do histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет все объекты из истории."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除历史记录中的所有项目。"
          }
        }
      }
    },
    "Removes the extension and everything it stored — its preferences, its cache and its own files. Its commands leave the launcher." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt die Erweiterung und alles, was sie gespeichert hat – ihre Einstellungen, ihren Cache und ihre eigenen Dateien. Ihre Befehle verschwinden aus dem Launcher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina la extensión y todo lo que guardó: sus preferencias, su caché y sus archivos. Sus comandos desaparecen del lanzador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime l’extension et tout ce qu’elle a stocké : ses préférences, son cache et ses propres fichiers. Ses commandes disparaissent du lanceur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拡張機能と、その環境設定、キャッシュ、独自のファイルなど、保存されているすべてを削除します。そのコマンドはランチャーから消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확장 프로그램과 저장된 모든 항목(환경설정, 캐시, 자체 파일)을 제거합니다. 해당 명령이 런처에서 사라집니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove a extensão e tudo o que ela armazenou — as preferências, o cache e os arquivos próprios. Os comandos dela saem do iniciador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет расширение и всё, что оно хранило: его настройки, кэш и собственные файлы. Его команды исчезают из лаунчера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除该扩展及其存储的所有内容，包括其偏好设置、缓存和自有文件。其命令也会从启动器中消失。"
          }
        }
      }
    },
