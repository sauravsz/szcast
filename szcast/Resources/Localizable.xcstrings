    "Resizes the launcher and its panels, but not Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skaliert den Launcher und seine Bereiche, nicht die Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia la escala del lanzador y sus paneles, no de Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrandit le lanceur et ses panneaux, mais pas les réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ランチャーとそのパネルが拡大縮小されます。設定は対象外です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "런처와 패널의 크기를 조절하며 설정에는 적용되지 않습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimensiona o iniciador e os painéis dele, não os Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Масштабирует лаунчер и его панели, но не настройки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缩放启动器及其面板，不包括“设置”。"
          }
        }
      }
    },
    "Resizes the window you were last in, on the display it is already on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert die Größe des zuletzt verwendeten Fensters auf dem Display, auf dem es sich bereits befindet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redimensiona la última ventana que usaste en la pantalla donde ya está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redimensionne la dernière fenêtre utilisée sans changer d’écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後に使用していたウインドウを、現在あるディスプレイ上でサイズ変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막으로 사용한 윈도우의 크기를 해당 윈도우가 있는 디스플레이에서 조절합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redimensiona a última janela em que você esteve, na tela em que ela já está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменяет размер окна, в котором вы работали последним, на том дисплее, где оно уже находится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在窗口当前所在的显示器上，调整你上次使用的窗口的大小。"
          }
        }
      }
    },
    "Resolve the API key or endpoint error before saving." : {
      "localizations" : {
        "de" : {
