    "Run as you in /bin/zsh, or the interpreter a #! line names. Use full executable paths." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird als du in /bin/zsh oder dem in einer #!-Zeile genannten Interpreter ausgeführt. Verwende vollständige Pfade zu ausführbaren Dateien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecuta con tu usuario en /bin/zsh o en el intérprete indicado en una línea #!. Usa rutas completas para los ejecutables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les commandes s’exécutent avec votre compte, via /bin/zsh ou l’interpréteur indiqué par #!. Utilisez des chemins absolus pour les exécutables."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/bin/zsh、または#!行で指定されたインタプリタで、あなたとして実行されます。実行可能ファイルのフルパスを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/bin/zsh 또는 #! 줄에 지정된 인터프리터에서 사용자 권한으로 실행됩니다. 전체 실행 파일 경로를 사용하십시오."
