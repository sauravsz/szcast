    "Sent before every message, after szcast's own. Both are billed each turn." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird vor jeder Nachricht gesendet, nach dem eigenen Prompt von szcast. Beide werden bei jedem Durchgang berechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envían antes de cada mensaje, después de las de szcast. Ambas se facturan en cada turno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyées avec chaque message, après celles de szcast. Les deux comptent dans la facturation des API payantes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "szcast自体のプロンプトの後、すべてのメッセージの前に送信されます。どちらも毎ターン課金されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "szcast 자체 프롬프트 다음에 모든 메시지 앞에 전송됩니다. 두 프롬프트 모두 매 턴마다 과금됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado antes de cada mensagem, depois do prompt do próprio szcast. Ambos são cobrados a cada turno."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляется перед каждым сообщением, после собственного запроса szcast. Оба оплачиваются на каждом ходе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每条信息之前发送，位于 szcast 自身的提示词之后。每轮对话两者都会计费。"
          }
        }
      }
    },
    "Sent even when the system prompt is off, but never to Apple Intelligence." : {
      "localizations" : {
