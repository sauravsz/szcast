    "Bring your shortcuts, favorites, and clipboard history along." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring deine Kurzbefehle, Favoriten und deinen Zwischenablageverlauf mit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva contigo tus atajos, favoritos e historial del portapapeles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez vos raccourcis, vos favoris et l’historique de votre presse-papiers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカット、よく使う項目、クリップボード履歴を引き継ぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키, 즐겨찾기, 클립보드 기록을 함께 가져옵니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leve junto seus atalhos, favoritos e histórico da área de transferência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перенесите свои сочетания клавиш, избранное и историю буфера обмена."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一并带上你的快捷键、个人收藏和剪贴板历史记录。"
          }
        }
      }
    },
    "Bring your words in from anywhere. Nothing is added until you review it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere deine Wörter von überall. Nichts wird hinzugefügt, bevor du es geprüft hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trae tus palabras desde cualquier lugar. No se añadirá nada hasta que lo revises."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez vos mots depuis n’importe où. Rien n’est ajouté avant votre validation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこからでも単語を取り込めます。確認するまで何も追加されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어디서든 단어를 가져오십시오. 검토하기 전에는 아무것도 추가되지 않습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traga suas palavras de qualquer lugar. Nada é adicionado até que você revise."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импортируйте слова откуда угодно. Ничего не будет добавлено, пока вы не проверите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从任何地方导入词汇。在你确认之前不会添加任何内容。"
          }
        }
      }
    },
