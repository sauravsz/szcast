    "Colon-separated, like PATH — checked before Homebrew and the rest. For mise: ~/.local/share/mise/shims. For Nix (Home Manager): /etc/profiles/per-user/<you>/home-path/bin." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch Doppelpunkte getrennt, wie PATH – wird vor Homebrew und dem Rest geprüft. Für mise: ~/.local/share/mise/shims. Für Nix (Home Manager): /etc/profiles/per-user/<you>/home-path/bin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separado por dos puntos, como PATH; se comprueba antes que Homebrew y el resto. Para mise: ~/.local/share/mise/shims. Para Nix (Home Manager): /etc/profiles/per-user/<you>/home-path/bin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séparés par des deux-points, comme PATH ; vérifiés avant Homebrew et le reste. Pour mise : ~/.local/share/mise/shims. Pour Nix (Home Manager) : /etc/profiles/per-user/<you>/home-path/bin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PATHのようにコロンで区切ります。Homebrewなどより先に確認されます。miseの場合: ~/.local/share/mise/shims。Nix（Home Manager）の場合: /etc/profiles/per-user/<you>/home-path/bin。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PATH처럼 콜론으로 구분하며, Homebrew 및 나머지보다 먼저 확인합니다. mise의 경우: ~/.local/share/mise/shims. Nix(Home Manager)의 경우: /etc/profiles/per-user/<you>/home-path/bin."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separados por dois-pontos, como PATH — verificados antes do Homebrew e dos demais. Para mise: ~/.local/share/mise/shims. Para Nix (Home Manager): /etc/profiles/per-user/<you>/home-path/bin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через двоеточие, как PATH — проверяется раньше Homebrew и остальных. Для mise: ~/.local/share/mise/shims. Для Nix (Home Manager): /etc/profiles/per-user/<you>/home-path/bin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以冒号分隔，与 PATH 相同，会先于 Homebrew 等其他路径检查。mise：~/.local/share/mise/shims。Nix (Home Manager)：/etc/profiles/per-user/<you>/home-path/bin。"
          }
        }
      }
    },
