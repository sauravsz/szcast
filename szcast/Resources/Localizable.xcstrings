    "Inset every window by the gap set above, as the tiling commands do." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Fenster um den oben festgelegten Abstand einrücken, wie es die Kachelbefehle tun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicar a cada ventana el espacio definido arriba, como hacen los comandos de mosaico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applique l’espace défini dans les réglages entre les fenêtres et les bords de l’écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイルコマンドと同様に、上で設定した間隔ですべてのウインドウを内側に寄せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타일링 명령과 같이 모든 윈도우를 위에서 설정한 간격만큼 안쪽으로 들입니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuar todas as janelas pelo espaço definido acima, como fazem os comandos de lado a lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отступ каждого окна на заданный выше промежуток, как у команд мозаики."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与平铺命令一样，按上方设置的间距内缩每个窗口。"
          }
        }
      }
    },
