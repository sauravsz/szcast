    "Groq provides free Whisper STT (2,000 req/day) and Llama 3.1 cleanup (14,400 req/day) with sub-second turnaround." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groq bietet kostenloses Whisper STT (2.000 Anfr./Tag) und Llama 3.1-Bereinigung (14.400 Anfr./Tag) in unter einer Sekunde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groq ofrece Whisper STT gratuito (2.000 sol./día) y limpieza con Llama 3.1 (14.400 sol./día) con respuesta inferior a un segundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groq fournit Whisper STT gratuit (2 000 req/jour) et le nettoyage Llama 3.1 (14 400 req/jour) en moins d’une seconde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groqは無料のWhisper STT（1日2,000リクエスト）とLlama 3.1テキスト整形（1日14,400リクエスト）を1秒未満で処理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groq는 무료 Whisper STT(일 2,000건)와 Llama 3.1 텍스트 정리(일 14,400건)를 1초 미만의 응답 속도로 제공합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Groq oferece Whisper STT gratuito (2.000 req/dia) e limpeza com Llama 3.1 (14.400 req/dia) com resposta abaixo de 1 segundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groq предоставляет бесплатное распознавание Whisper STT (2 000 запр./день) и очистку Llama 3.1 (14 400 запр./день) быстрее одной секунды."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groq 提供免费的 Whisper 语音识别（2,000 次/天）和 Llama 3.1 文本润色（14,400 次/天），响应时间低于 1 秒。"
          }
        }
      }
    },
