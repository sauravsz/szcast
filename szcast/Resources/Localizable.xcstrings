            "value" : "받아쓰기 중에 스니펫의 트리거 키워드를 말하면 자동으로 확장됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga a palavra-chave de um snippet durante o ditado para expandi-lo automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Произнесите ключевое слово сниппета во время диктовки для автоматической подстановки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在听写时说出片段的触发关键词即可自动展开。"
          }
        }
      }
    },
    "Say comma, period, or new paragraph to insert it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sage „comma“ (Komma), „period“ (Punkt) oder „new paragraph“ (neuer Absatz), um es einzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di «comma» (coma), «period» (punto) o «new paragraph» (nuevo párrafo) para insertarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites « comma » (virgule), « period » (point) ou « new paragraph » (nouveau paragraphe) pour l’insérer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「comma」（コンマ）、「period」（ピリオド）、または「new paragraph」（新しい段落）と話して挿入します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"comma\"(쉼표), \"period\"(마침표) 또는 \"new paragraph\"(새 단락)라고 말하여 삽입하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga \"comma\" (vírgula), \"period\" (ponto) ou \"new paragraph\" (novo parágrafo) para inserir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Произнесите «comma» (запятая), «period» (точка) или «new paragraph» (новый абзац) для вставки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
