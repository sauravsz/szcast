    "Applications with unsaved changes may ask you to save." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps mit nicht gesicherten Änderungen fragen dich möglicherweise, ob du sichern möchtest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las aplicaciones con cambios sin guardar pueden pedirte que los guardes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les applications comportant des modifications non enregistrées peuvent vous demander de les enregistrer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未保存の変更があるアプリケーションは、保存を求める場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하지 않은 변경 사항이 있는 응용 프로그램은 저장 여부를 물을 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicativos com alterações não salvas podem pedir que você salve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложения с несохранёнными изменениями могут предложить сохранить их."
