          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키는 일반적으로 'gsk_'로 시작합니다. macOS 키체인에 안전하게 저장됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
