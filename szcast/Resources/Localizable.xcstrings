          }
        }
      }
    },
    "%@ has no built command bundles. szcast installs prebuilt extensions — run `ray build` in the extension folder first, or import one from an installed Raycast." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat keine erstellten Befehls-Bundles. szcast installiert vorgefertigte Erweiterungen – führe zuerst `ray build` im Erweiterungsordner aus oder importiere eine aus einem installierten Raycast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no tiene paquetes de comandos compilados. szcast instala extensiones ya compiladas; ejecuta `ray build` primero en la carpeta de la extensión o importa una desde un Raycast instalado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas de bundles de commandes compilés. szcast installe des extensions précompilées : exécutez d’abord `ray build` dans le dossier de l’extension, ou importez-en une depuis un Raycast installé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にはビルド済みのコマンドバンドルがありません。szcastはビルド済みの拡張機能をインストールします。先に拡張機能のフォルダで`ray build`を実行するか、インストール済みのRaycastから読み込んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 빌드된 명령 번들이 없습니다. szcast는 미리 빌드된 확장 프로그램을 설치합니다. 먼저 확장 프로그램 폴더에서 `ray build`를 실행하거나 설치된 Raycast에서 가져오십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não tem pacotes de comandos compilados. O szcast instala extensões já compiladas — execute `ray build` na pasta da extensão primeiro ou importe uma de um Raycast instalado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У «%@» нет собранных пакетов команд. szcast устанавливает уже собранные расширения — сначала выполните `ray build` в папке расширения или импортируйте его из установленного Raycast."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有已构建的命令包。szcast 只安装预构建的扩展，请先在扩展文件夹中运行 `ray build`，或从已安装的 Raycast 导入。"
          }
        }
      }
    },
