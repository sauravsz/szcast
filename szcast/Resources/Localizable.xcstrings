        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 빌드된 번들이 없습니다. 확장 프로그램을 다시 설치하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
