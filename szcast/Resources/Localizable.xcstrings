          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores booleanos devem ser exatamente 'true' ou 'false'"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Логические значения должны быть строго «true» или «false»"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布尔值必须恰好是“true”或“false”"
          }
        }
      }
    },
    "Boosts microphone sensitivity for soft, sub-vocal whispered speech in quiet rooms." : {
      "localizations" : {
