        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての検索の下に「…を使用」として表示されます。{argument}を含むクイックリンクも対象です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 검색 아래에 ‘…에서 사용’으로 표시됩니다. {argument}가 있는 빠른 링크도 포함됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exibidos abaixo de cada busca como “Usar … com”. Inclui links rápidos com um {argument}."
          }
