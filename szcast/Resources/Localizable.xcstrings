          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Node не найден. Установите Node.js, добавьте папку, в которой он находится, в «Свои пути поиска» либо установите это расширение из Raycast Store."
          }
