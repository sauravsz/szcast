    "Keys stay in your login Keychain, tied to the endpoint they were saved for." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlüssel bleiben in deinem Anmeldeschlüsselbund, gebunden an den Endpunkt, für den sie gesichert wurden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves se guardan en tu llavero de inicio de sesión, vinculadas al endpoint para el que se guardaron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés restent dans votre trousseau de session, liées au point de terminaison pour lequel elles ont été enregistrées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーはログインキーチェーンに保存され、保存時のエンドポイントに関連付けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키는 저장된 엔드포인트에 연결된 상태로 로그인 키체인에 보관됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves ficam no Acesso às Chaves (chaveiro de login), vinculadas ao endpoint para o qual foram salvas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключи хранятся в вашей связке ключей входа и привязаны к адресу, для которого были сохранены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥保存在你的登录钥匙串中，并与存储时所对应的端点绑定。"
          }
        }
      }
    },
    "Keys typically start with 'gsk_'. Stored securely in macOS Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlüssel beginnen typischerweise mit ‚gsk_‘. Sicher im macOS-Schlüsselbund gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves suelen empezar por 'gsk_'. Se almacenan de forma segura en el llavero de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés commencent généralement par « gsk_ ». Stockées en toute sécurité dans le trousseau macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
