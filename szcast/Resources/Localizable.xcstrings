    "Ask Each Chat" : {
      "comment" : "MCP trust level; quoted by name elsewhere, translate identically",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei jedem Chat fragen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preguntar en cada chat"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demander à chaque conversation"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャットごとに確認"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅마다 묻기"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perguntar a cada chat"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спрашивать в каждом чате"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个聊天都询问"
          }
        }
      }
    },
    "Ask Each Chat puts the first tool call of every conversation through a confirmation. Never Allow withholds the server without removing it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bei jedem Chat fragen“ verlangt für den ersten Tool-Aufruf jeder Unterhaltung eine Bestätigung. „Nie erlauben“ hält den Server zurück, ohne ihn zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preguntar en cada chat pide confirmación en la primera llamada a una herramienta de cada conversación. No permitir nunca retiene el servidor sin eliminarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Demander à chaque conversation » demande votre accord avant le premier appel d’outil. « Ne jamais autoriser » bloque l’accès aux outils du serveur sans le supprimer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「チャットごとに確認」では、各会話の最初のツール呼び出しで確認が行われます。「許可しない」では、サーバを削除せずに利用を差し控えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘채팅마다 묻기’는 모든 대화의 첫 도구 호출에 확인을 요구합니다. ‘허용 안 함’은 서버를 제거하지 않고 사용하지 못하게 합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perguntar a cada chat exige confirmação na primeira chamada de ferramenta de cada conversa. Nunca permitir retém o servidor sem removê-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Спрашивать в каждом чате» требует подтверждения первого вызова инструмента в каждом разговоре. «Никогда не разрешать» отключает сервер, не удаляя его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“每个聊天都询问”会让每个对话的首次工具调用经过确认。“永不允许”会停用该服务器但不移除它。"
          }
        }
      }
    },
