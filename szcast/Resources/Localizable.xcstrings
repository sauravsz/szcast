    "Track active, wired, compressed, and swap memory allocations." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktive, reservierte, komprimierte und Swap-Speicherbelegung verfolgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supervisa las asignaciones de memoria activa, residente, comprimida y de intercambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suit les allocations de mémoire active, résidente, compressée et swap."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティブ、確保済み、圧縮、スワップメモリの割り当てを追跡します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성, 와이어드, 압축됨 및 스왑 메모리 할당량을 추적합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe alocações de memória ativa, residente, comprimida e swap."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отслеживание активной, резидентной, сжатой памяти и файла подкачки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追踪活跃、联动、已压缩和交换内存的分配情况。"
          }
        }
      }
    },
