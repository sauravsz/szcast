    "Replace writes into your document, and undo restores it. Preview shows a panel first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ersetzen“ schreibt in dein Dokument, und „Widerrufen“ stellt es wieder her. „Vorschau“ zeigt zuerst einen Bereich an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplazar escribe en tu documento y deshacer lo restaura. Previsualizar muestra primero un panel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Remplacer » remplace le texte sélectionné. Vous pouvez annuler cette modification. « Aperçu » affiche d’abord le résultat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「置き換える」は書類に直接書き込み、取り消すと元に戻ります。「プレビュー」では、先にパネルが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘교체’는 문서에 직접 쓰며 실행 취소로 복원할 수 있습니다. ‘미리보기’는 먼저 패널을 표시합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substituir escreve no seu documento, e desfazer o restaura. Pré-visualizar mostra um painel primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Заменить» записывает результат в ваш документ, а отмена восстанавливает его. «Предпросмотр» сначала показывает панель."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
