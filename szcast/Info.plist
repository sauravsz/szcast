<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>SzcastURLScheme</key>
	<string>$(SZCAST_URL_SCHEME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Raycast and szcast URL Scheme</string>
			<!-- `raycast` is claimed so a Raycast store link opens szcast's install panel.
			     The escalation that made this risky is closed in the parser: a URL can no
			     longer request `launchType=background` (ExtensionDeepLink.route), so a link
			     only ever reaches a confirmation panel or a foreground command. -->
			<key>CFBundleURLSchemes</key>
			<array>
				<string>raycast</string>
				<string>$(SZCAST_URL_SCHEME)</string>
				<string>com.raycast</string>
			</array>
		</dict>
	</array>
	<!-- Exported, but deliberately no CFBundleDocumentTypes: claiming the type would make a
	     double-clicked .szcast launch straight into writing over someone's data. The identifier
	     is fixed rather than per-channel so Dev and stable can read each other's exports. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.sauravsz.szcast.backup</string>
			<key>UTTypeDescription</key>
			<string>szcast Backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>szcast</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAutoFillRequiresTextContentTypeForOneTimeCodeOnMac</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>szcast uses automation to perform system actions you explicitly run.</string>
	<key>NSCameraUsageDescription</key>
	<string>szcast shows a camera preview so you can check yourself, and take a photo to the clipboard.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>szcast records audio only while you use Dictation, to transcribe it on your Mac.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>szcast accesses your events to show your schedule and let you join meetings.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>szcast lets extensions you run read and edit your reminders.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>szcast uses Bluetooth access only when you run the Toggle Bluetooth action.</string>
	<key>NSHumanReadableCopyright</key>
	<string>szcast</string>
	<key>SzcastUpdatePublicKey</key>
	<string>IwtZDpObVvUn0+fexjf+7U8fV/w50jcdQqRhp1iBvac=</string>
</dict>
</plist>
